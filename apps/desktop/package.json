{
  "name": "@axiom/desktop",
  "version": "2.9.0",
  "private": true,
  "description": "Axiom desktop application — hardened Electron shell (PRD Epoch A/B).",
  "author": "Axiom",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "npm run build && electron-vite preview",
    "package": "node scripts/prepare-package-output.cjs && electron-vite build && electron-builder --win --config.win.sign=null",
    "package:dir": "node scripts/prepare-package-output.cjs && electron-vite build && electron-builder --win --dir --config.win.sign=null",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "validate:agentic-chat": "node scripts/validate-agentic-chat.cjs",
    "validate:github-scm": "node scripts/validate-github-scm.cjs",
    "validate:security-hardening": "node scripts/validate-security-hardening.cjs",
    "validate:god-mode": "node scripts/validate-god-mode.cjs",
    "validate:extension-platform": "node scripts/validate-extension-platform.cjs"
  },
  "dependencies": {
    "@axiom/shared": "*",
    "@supabase/supabase-js": "^2.110.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "isomorphic-git": "^1.38.6",
    "jsonc-parser": "3.3.1",
    "monaco-editor": "^0.52.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "3.36.0",
    "typescript-language-server": "^4.3.3",
    "vscode-langservers-extracted": "^4.10.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "ws": "^8.18.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  }
}
